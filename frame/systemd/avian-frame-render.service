[Unit]
Description=Generate Avian Visitors frame
After=network-online.target caddy.service
Wants=network-online.target

[Service]
Type=oneshot
User=__AVIAN_USER__
WorkingDirectory=__AVIAN_HOME__/BirdNET-Pi/frame
ExecStart=__AVIAN_HOME__/BirdNET-Pi/frame/.venv/bin/python __AVIAN_HOME__/BirdNET-Pi/frame/server/render-frame.py
