[Unit]
Description=Nightly AvianVisitors archive at 03:15

[Timer]
# 03:15: safely past the 02:00 disk_species_clean cron window; completed days
# are quiescent at any hour, so nothing is gained by running earlier
OnCalendar=*-*-* 03:15:00
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
